<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="css/sidebar.css">
</head>
<body>
    
<aside class="sidebar">

    <div class="sidebar__header">
        <h2 class="sidebar__heading">Workspace</h2>
    </div>

    <nav class="sidebar__nav">

        <ul class="sidebar__list">

            <li class="sidebar__list-item">
                <a class="sidebar__anchor" href="/">
                    <i class="fa-solid fa-house"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li class="sidebar__list-item">
                <a class="sidebar__anchor sidebar__anchor--active"
                   href="/">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Create Post</span>
                </a>
            </li>

            <li class="sidebar__list-item">
                <a class="sidebar__anchor" href="/posts">
                    <i class="fa-solid fa-file-lines"></i>
                    <span>All Posts</span>
                </a>
            </li>

            <li class="sidebar__list-item">
                <a class="sidebar__anchor" href="/edit">
                    <i class="fa-solid fa-pen"></i>
                    <span>Edit Posts</span>
                </a>
            </li>

            <li class="sidebar__list-item">
                <a class="sidebar__anchor" href="/delete">
                    <i class="fa-solid fa-trash"></i>
                    <span>Delete Posts</span>
                </a>
            </li>

        </ul>

    </nav>

    <div class="sidebar__profile">
        <div class="sidebar__avatar">M</div>

        <div class="sidebar__user">
            <h3>Masud</h3>
            <p>Administrator</p>
        </div>
    </div>

</aside>

</body>
</html>