<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>footer</title>
    <link rel="stylesheet" href="css/footer.css">
</head>
<body>
    
<footer class="footer">

    <div class="footer__container">

        <!-- Brand Section -->
        <div class="footer__brand">

            <a href="/" class="footer__logo">
                <i class="fa-solid fa-pen-nib"></i>
                BlogSpace
            </a>

            <p class="footer__description">
                A place to share ideas, explore knowledge
                and express your thoughts with the world.
            </p>

            <div class="footer__social">

                <a href="#" class="footer__social-link"
                   aria-label="Facebook">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>

                <a href="#" class="footer__social-link"
                   aria-label="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                </a>

                <a href="#" class="footer__social-link"
                   aria-label="LinkedIn">
                    <i class="fa-brands fa-linkedin-in"></i>
                </a>

                <a href="#" class="footer__social-link"
                   aria-label="GitHub">
                    <i class="fa-brands fa-github"></i>
                </a>

            </div>

        </div>

        <!-- Quick Links -->
        <div class="footer__section">

            <h3 class="footer__heading">Quick Links</h3>

            <ul class="footer__list">

                <li class="footer__list-item">
                    <a href="/" class="footer__link">Home</a>
                </li>

                <li class="footer__list-item">
                    <a href="/about" class="footer__link">About Us</a>
                </li>

                <li class="footer__list-item">
                    <a href="/posts" class="footer__link">All Posts</a>
                </li>

                <li class="footer__list-item">
                    <a href="/contact" class="footer__link">Contact</a>
                </li>

            </ul>

        </div>

        <!-- Resources -->
        <div class="footer__section">

            <h3 class="footer__heading">Resources</h3>

            <ul class="footer__list">

                <li class="footer__list-item">
                    <a href="/create" class="footer__link">Write a Blog</a>
                </li>

                <li class="footer__list-item">
                    <a href="/privacy" class="footer__link">Privacy Policy</a>
                </li>

                <li class="footer__list-item">
                    <a href="/terms" class="footer__link">Terms & Conditions</a>
                </li>

            </ul>

        </div>

        <!-- Contact -->
        <div class="footer__section">

            <h3 class="footer__heading">Get in Touch</h3>

            <p class="footer__contact-text">
                Have questions or suggestions?
                We'd love to hear from you.
            </p>

            <a href="/contact" class="footer__contact-link">
                Contact Us
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>

    </div>

    <!-- Footer Bottom -->
    <div class="footer__bottom">

        <p class="footer__copyright">
            &copy; <%= new Date().getFullYear() %> BlogSpace.
            All rights reserved.
        </p>

        <p class="footer__credit">
            Made with <i class="fa-solid fa-heart"></i> for readers and writers.
        </p>

    </div>

</footer>

</body>
</html>