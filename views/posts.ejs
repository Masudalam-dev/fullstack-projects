<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
</head>
<body>
    <h1>All Posts</h1>
    <% blogPosts.forEach((post) => { %>
        <article>
            <h2> <%= post.title %></h2>
            <p><%= post.content %></p>
            <small><%= post.date %></small>
        </article>
        
    <% }); %>
</body>
</html>